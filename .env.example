# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_FUNCTIONS_BASE_URL=https://your-project-id.supabase.co/functions/v1/your-function-name

# Supabase Edge Function (Deno)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_API_PREFIX=/your-function-name
APP_STORAGE_BUCKET_NAME=your-media-bucket
APP_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173
# Must be an allowed origin and configured in Supabase Auth Redirect URLs.
APP_AUTH_REDIRECT_URL=https://your-frontend-domain.com/reset-password
APP_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
# Initial governance account(s). This list is not exposed to the frontend.
# A super administrator cannot be assigned through the application UI/API.
APP_BOOTSTRAP_SUPER_ADMIN_EMAILS=super-admin@example.com
# Production security controls. APP_REQUIRE_ADMIN_MFA must be true after MFA is
# enabled for administrator accounts in Supabase Auth.
APP_REQUIRE_ADMIN_MFA=false
APP_SIGNED_URL_TTL_SECONDS=300
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_PUBLIC_MAX=120
APP_RATE_LIMIT_AUTH_MAX=10
APP_RATE_LIMIT_ADMIN_MAX=60
