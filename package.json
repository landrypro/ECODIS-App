{
  "name": "ecodis-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.18.x",
    "npm": "11.12.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "test:backend": "deno check --config supabase/functions/server/deno.json supabase/functions/server/index.ts && deno test --config supabase/functions/server/deno.json --allow-env --allow-net supabase/functions/server",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:test:migrations": "supabase db reset --local && supabase db lint --local",
    "test:all": "npm run check && npm run test && npm run build",
    "recette:staging": "node recette-staging.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
